# Copy to .env and fill in (or run `yap init`, which generates a config like
# this in the instance directory). The server loads the first env file that
# exists — YAP_ENV_FILE, else ./.env — with Node's built-in parser. Real
# environment variables override these, so in a deployment you can inject
# secrets via the environment and leave this for local dev only.
# Generate a master key with: openssl rand -base64 32

# --- Required ---------------------------------------------------------------
# Environment credential for user provisioning over REST (>= 16 chars).
# Authenticates the REST API only, never MCP.
YAP_SYSADMIN_KEY=change-me-at-least-16-chars
# Base64-encoded 32 bytes: service-config encryption + link/token signing.
YAP_MASTER_KEY=

# --- Listener ---------------------------------------------------------------
YAP_PORT=8787
YAP_HOST=0.0.0.0
# Public origin used when minting absolute file/widget links. Set this to the
# server's externally reachable URL for any non-localhost deployment.
# YAP_BASE_URL=http://localhost:8787

# --- Structured-data store (default: SQLite) --------------------------------
YAP_DB=sqlite
YAP_SQLITE_PATH=./data/yap.db
# For Postgres instead:
# YAP_DB=postgres
# YAP_DATABASE_URL=postgres://user:pass@host:5432/yap

# --- Blob store (default: local disk) ---------------------------------------
YAP_BLOB=fs
YAP_BLOB_FS_ROOT=./data/blobs
# For S3-compatible storage instead:
# YAP_BLOB=s3
# YAP_S3_BUCKET=my-bucket
# YAP_S3_REGION=auto
# YAP_S3_ENDPOINT=https://...        # for R2/MinIO/etc.
# YAP_S3_ACCESS_KEY_ID=
# YAP_S3_SECRET_ACCESS_KEY=
# YAP_S3_FORCE_PATH_STYLE=false

# --- Service drivers ---------------------------------------------------------
# One folder per installed driver (a package.json declaring yap.driverApi plus
# its entry module); loaded at startup. A missing directory means built-ins only.
# YAP_DRIVERS_DIR=./drivers

# --- Backups -----------------------------------------------------------------
# Automatic pre-migration and pre-upgrade backups are ON by default; archives
# are portable across SQLite/Postgres and fs/S3 (restore with `yap restore`).
# YAP_BACKUP_BEFORE_MIGRATE=true      # snapshot before pending schema migrations
# YAP_BACKUP_SINK=fs                  # fs | s3
# YAP_BACKUP_FS_ROOT=./data/backups
# YAP_BACKUP_SCHEDULE=                # cron expression, e.g. "0 3 * * *" (off when unset)
# YAP_BACKUP_KEEP=                    # prune sink to the newest n archives
# For an S3 sink (credentials fall back to YAP_S3_*/AWS_*):
# YAP_BACKUP_S3_BUCKET=
# YAP_BACKUP_S3_PREFIX=
# YAP_BACKUP_S3_REGION=auto
# YAP_BACKUP_S3_ENDPOINT=
# YAP_BACKUP_S3_ACCESS_KEY_ID=
# YAP_BACKUP_S3_SECRET_ACCESS_KEY=

# --- Operational policy (operator-overridable defaults) ---------------------
# YAP_MAX_FILE_SIZE_BYTES=52428800
# YAP_MIME_ALLOWLIST=*                # or e.g. "image/*, application/pdf"
# YAP_UPLOAD_TTL_SECONDS=600
# YAP_DOWNLOAD_TTL_SECONDS=14400
# YAP_WIDGET_TOKEN_TTL_SECONDS=600
# YAP_SECRET_REQUEST_TTL_SECONDS=600     # the one-off secret form, and a service approve page
# YAP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# YAP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# YAP_OAUTH_CODE_TTL_SECONDS=60
# YAP_OAUTH_MAX_ROLE=                 # highest role the consent screen offers: admin | member | read-only (unset = admin)
# YAP_KEY_LOGIN=true                  # "false": no access-key login anywhere (pages, /v1, /mcp) and no user keys; needs a YAP_OIDC_PROVIDERS entry
# YAP_HOOK_TIMEOUT_MS=30000           # the http driver's per-call timeout (other drivers declare their own)
# YAP_HOOK_ALLOW_HOSTS=               # comma list of internal hosts any driver's egress may reach (SSRF-guard exceptions)
# YAP_RUN_WAIT_CAP_MS=25000           # longest a caller may block waiting for a run
# YAP_RUN_TIMEOUT_CAP_MS=             # optional ceiling on any driver action's own timeout
# YAP_RUN_RETENTION_DAYS=7            # finished runs are pruned after this many days
# YAP_SCHEDULER=on                    # fire service schedules in this process; "on" in exactly one process per database
# YAP_ORPHAN_SWEEP_INTERVAL_MS=600000
# YAP_ORPHAN_MAX_AGE_MS=3600000

# Optional: force a specific env file (beats the instance directory's ./.env).
# Set this in the real environment — it decides which file gets loaded, so it
# can't live inside one.
# YAP_ENV_FILE=.env

# --- Login providers (OpenID Connect) -----------------------------------------
# Optional. Each provider adds "Continue with {label}" to the consent screen,
# the connected-apps page, a service's approve page and its secret form; access
# keys stay the second option. Needs YAP_BASE_URL. Register Core at the provider
# with the redirect URI <YAP_BASE_URL>/oidc/<name>/callback. See docs/oidc-login.md.
# YAP_OIDC_PROVIDERS=google
# YAP_OIDC_GOOGLE_ISSUER=https://accounts.google.com
# YAP_OIDC_GOOGLE_CLIENT_ID=
# YAP_OIDC_GOOGLE_CLIENT_SECRET=
# YAP_OIDC_GOOGLE_LABEL=Google
# YAP_OIDC_GOOGLE_GRANT_MAX_DAYS=     # this provider's grant lifetime (default YAP_OIDC_GRANT_MAX_DAYS)
# YAP_OIDC_GOOGLE_PRESET=google      # how its ID token is read: generic, google (hd check) or entra; default generic, google for Google's issuer
# YAP_OIDC_GOOGLE_EMAIL_CLAIM=        # the email claim, or a comma list tried in order (default: the preset's); any but email needs TRUST_EMAIL=true
# YAP_OIDC_GOOGLE_TRUST_EMAIL=        # "true": accept the email without email_verified (default: the preset's)
# YAP_OIDC_GOOGLE_SUBJECT_CLAIM=      # the claim that identifies a returning person (default: the preset's)
# Microsoft Entra ID: the entra preset, with the single-tenant v2.0 issuer.
# YAP_OIDC_PROVIDERS=google,microsoft
# YAP_OIDC_MICROSOFT_PRESET=entra
# YAP_OIDC_MICROSOFT_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# YAP_OIDC_MICROSOFT_CLIENT_ID=
# YAP_OIDC_MICROSOFT_CLIENT_SECRET=
# YAP_OIDC_MICROSOFT_LABEL=Microsoft
# YAP_OIDC_GRANT_MAX_DAYS=30          # an OAuth grant made after a provider login ends this long after it was made
# YAP_OIDC_SIGNUP=false               # let a first login without an account create one
# YAP_OIDC_ALLOW=                     # who sign-up admits: addresses and @domain entries, comma-separated
